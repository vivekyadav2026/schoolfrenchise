# ----------------------------------------------------------------------
# Drishti Computer Education - Root Directory Protection & Forwarder
# ----------------------------------------------------------------------
# If the hosting server DocumentRoot is correctly set to `/public`,
# this file will not be reached. If DocumentRoot is mistakenly pointed
# to the project root, this file prevents data leakage and routes to /public.
# ----------------------------------------------------------------------

Options -Indexes

# Block direct access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive configuration and application folders
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny access to sensitive root files
    RewriteRule ^(\.env|\.git|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|README\.md|DEPLOYMENT_CHECKLIST\.md) - [F,L,NC]

    # Deny access to internal PHP directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # Route remaining public traffic into public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
